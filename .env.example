# Copy this file, name the copy ".env", and fill in the values. See README step 4.

# From @BotFather (README step 1)
TELEGRAM_BOT_TOKEN=

# The long code in your Google Sheet's web address (README step 3)
GOOGLE_SHEETS_ID=

# Your Telegram user ID. Leave empty at first — the bot will tell you what it is.
# Several people? Separate with commas: 123456789,987654321
ALLOWED_USER_IDS=

# Only needed on Railway. When running on your own computer, leave this empty
# and put service_account.json in the project folder instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
